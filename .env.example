# 复制成 .env —— /lab-start 会自动把 LLM 那两行填好,你通常只需要补投递凭据。
# .env 已被 .gitignore 挡掉。**凭据一旦进了 git 历史,删文件没用,得改密码。**

# ── LLM(/lab-start 自动注入;你不需要自己的 Anthropic key)────────────────
# 故意用 PARALLIGHT_ 前缀而不是 ANTHROPIC_API_KEY,避免和你机器上已有的 key 打架。
PARALLIGHT_API_KEY=plk_...
PARALLIGHT_BASE_URL=https://token.parallight.ai/api/llm

# ── 挑战服务(GPU + 服务端打分)────────────────────────────────────────────
# 用的是同一个 plk_ token;留空的话 plk.py 会自动从上面那行 / ~/.claude/settings.json 找。
# ANTHROPIC_AUTH_TOKEN=plk_...
# PARALLIGHT_LAB_BASE=https://www.parallight.ai

# ── 投递渠道(在 config.yaml 选 channel,只配你选的那个)───────────────────

# 渠道 A:Gmail(在国外 / 沙箱在境外时推荐)
# ⚠️ 不是登录密码!先开两步验证,再到 https://myaccount.google.com/apppasswords
#    生成「应用专用密码」。
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_TO=                      # 收件人;留空就发给自己
# 换别的邮箱服务商改这两个:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# 渠道 B:飞书自定义机器人(在大陆推荐)
# ⚠️ 这个 URL 里那段 token 本身就是凭据 —— 谁拿到谁能往你群里发东西。
#    绝不进 git、不进截图、不贴在群里问问题。
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=        # 只在机器人开了「签名校验」时填;开「关键词」就留空

# ── 第 7 幕:G3 部署闸要查你仓库的 Actions 运行记录 ─────────────────────────
BROADCAST_REPO=               # 形如 yourname/your-automl-repo
GITHUB_PERSONAL_ACCESS_TOKEN= # fine-grained token,勾 actions:read 就够
